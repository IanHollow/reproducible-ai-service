# Example environment variables for the AIContentGuard Microservice

# API Configuration
API_PORT=8000

# Logging Configuration
LOG_LEVEL=INFO # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_TO_FILE=True # Enable/disable JSONL file logging (REQ-028)
# LOG_FORMAT=json # Uncomment for JSON formatted logs (REQ-011, REQ-028)

# Model Configuration (REQ-021)
SENTIMENT_MODEL_ID=distilbert-base-uncased-finetuned-sst-2-english
TOXICITY_MODEL_ID=unitary/toxic-bert
HATE_SPEECH_MODEL_ID=facebook/roberta-hate-speech-detection

# Optional: HuggingFace Cache Directory
# HF_CACHE_DIR=/path/to/your/cache/directory

# Optional: Ensemble Thresholds (REQ-012)
# TOXICITY_THRESHOLD=0.7
# HATE_SPEECH_THRESHOLD=0.7
